	cd /home/jzh/catkin_why/src/cmake-build-debug- && $(MAKE) $(MAKESILENT) -f lidar_perception-master/CMakeFiles/lidar_perception_node.dir/build.make lidar_perception-master/CMakeFiles/lidar_perception_node.dir/src/remove_ground/remove_ground.cpp.s
.PHONY : src/remove_ground/remove_ground.cpp.s

