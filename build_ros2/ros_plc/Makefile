# target to preprocess a source file
src/y_cut.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/y_cut.dir/build.make CMakeFiles/y_cut.dir/src/y_cut.cpp.i
.PHONY : src/y_cut.cpp.i

src/y_cut.s: src/y_cut.cpp.s
.PHONY : src/y_cut.s

# target to generate assembly for a file
src/y_cut.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/y_cut.dir/build.make CMakeFiles/y_cut.dir/src/y_cut.cpp.s
.PHONY : src/y_cut.cpp.s

